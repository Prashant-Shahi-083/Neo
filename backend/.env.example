# Deployment Environment Variables
# --------------------------------

# 1. Server Configuration
PORT=3002
NODE_ENV=production

# 2. Database Configuration (PostgreSQL for Prod)
DB_TYPE=postgres
DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# 3. Security
# Make sure to generate a strong random string for production!
JWT_SECRET=super_secret_jwt_key_for_production
CORS_ORIGIN=*

# 4. Storage (If using S3 / Cloudinary)
# STORAGE_PROVIDER=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_BUCKET_NAME=
